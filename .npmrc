# Exact versions only: `pnpm add` writes "1.2.3", never "^1.2.3".
save-exact=true

# Pin the @types scope to the public npm registry (same as furchert-ch).
# Dependabot's automatic GitHub Packages auth otherwise resolves @types/*
# from npm.pkg.github.com, whose legacy cache is frozen at ~17.x, which breaks
# dependency resolution for the pinned versions.
@types:registry=https://registry.npmjs.org/
